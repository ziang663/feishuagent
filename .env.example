# Feishu China: feishu; Lark global: lark
FEISHU_DOMAIN=feishu
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# OpenAI Responses API
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-5-mini
# Optional OpenAI-compatible endpoint that implements POST /responses
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REQUEST_TIMEOUT_SECONDS=120
OPENAI_SUMMARIZATION_CONCURRENCY=4

# Recommended: raises GitHub API limits from 60/hour to 5,000/hour.
GITHUB_TOKEN=github_pat_xxx

# Runtime tuning
MAX_CONCURRENT_REQUESTS=4
MAX_PENDING_REQUESTS=50
CACHE_TTL_SECONDS=600
GITHUB_MAX_LINKED_PRS=30
PORT=8080
